# Keil / ARM build output, including legacy projects that emit into MDK.
**/MDK/Build/
*.axf
*.hex
*.o
*.obj
*.d
*.crf
*.dep
*.lnp
*.map
*.lst
*.build_log.htm
**/MDK/*.htm
*.iex
*.plg
*.tra
*.log

# Local test executables and bundled tool binaries.
*.exe

# Device provisioning secrets and local environment files.
provision_secret.h
.env
.env.*
!.env.example

# Python bytecode and tool caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Keil UI state, editor backups, and OS/Office temporary files.
*.uvguix.*
*.uvgui.*
*.uv2gui.*
*.[Bb][Aa][Kk]
*.tmp
*~
~$*
Thumbs.db
Desktop.ini
.DS_Store
/$null
